---
import BaseLayout from "../layouts/BaseLayout.astro";
import BentoTile from "../components/BentoTile.astro";
import AmountChip from "../components/AmountChip.astro";
import { FARE_TABLE } from "../lib/fixtures";

const presetAmounts = [10, 20, 50, 100];
---

<BaseLayout title="Top up">
  <h1>Top up your balance</h1>
  <div class="page-stack">
    <BentoTile size="hero">
      <p class="top-up-card-lede">Choose an amount, or enter your own.</p>

      <div id="top-up-form-view">
        <div class="amount-chips" role="group" aria-label="Preset amounts">
          {presetAmounts.map((amount) => <AmountChip value={amount} />)}
        </div>
        <div class="field">
          <label for="custom-amount">Custom amount ($)</label>
          <input id="custom-amount" type="number" min="5" max="500" step="0.05" />
        </div>
        <button
          type="button"
          id="top-up-submit"
          class="btn positive full-width"
          disabled
        >
          Top up
        </button>
      </div>

      <div id="top-up-processing-view" class="top-up-status" hidden>
        <p>Processing your top-up…</p>
      </div>

      <div id="top-up-success-view" class="top-up-status" hidden>
        <p>
          Top-up complete. Your new balance is{" "}
          <strong id="new-balance" class="tabular-nums"></strong>.
        </p>
        <a href="../dashboard/" class="btn secondary full-width"
          >Back to dashboard</a
        >
      </div>
    </BentoTile>

    <BentoTile>
      <h2>Fares & caps</h2>
      <ul class="fare-facts">
        <li>
          <p class="fare-facts__label">Adult fares</p>
          <p class="fare-facts__detail">
            ${FARE_TABLE.adult.offPeak.toFixed(2)} off-peak to $
            {FARE_TABLE.adult.peak.toFixed(2)} at peak, current as of{" "}
            {FARE_TABLE.effectiveFrom}.
          </p>
        </li>
        <li>
          <p class="fare-facts__label">Daily cap</p>
          <p class="fare-facts__detail">
            Adult weekday travel is capped at $
            {FARE_TABLE.dailyCapAdultWeekday.toFixed(2)} a day — the rest of
            that day's trips are free.
          </p>
        </li>
        <li>
          <p class="fare-facts__label">Monthly cap</p>
          <p class="fare-facts__detail">
            After {FARE_TABLE.monthlyCapTrips} paid trips in a calendar month,
            the rest of that month's travel is free.
          </p>
        </li>
        <li>
          <p class="fare-facts__label">Free transfers</p>
          <p class="fare-facts__detail">
            Switch between bus and light rail within{" "}
            {FARE_TABLE.transferWindowMinutes} minutes of your first tap at no
            extra cost.
          </p>
        </li>
      </ul>
    </BentoTile>
  </div>
</BaseLayout>

<script>
  import { demoState } from "../lib/demo-state";
  import { formatCents } from "../lib/format";

  const chips = document.querySelectorAll<HTMLButtonElement>(".amount-chip");
  const customInput = document.querySelector<HTMLInputElement>(
    "#custom-amount",
  );
  const submitButton = document.querySelector<HTMLButtonElement>(
    "#top-up-submit",
  );
  const formView = document.querySelector<HTMLElement>("#top-up-form-view");
  const processingView = document.querySelector<HTMLElement>(
    "#top-up-processing-view",
  );
  const successView = document.querySelector<HTMLElement>(
    "#top-up-success-view",
  );
  const newBalanceEl = document.querySelector<HTMLElement>("#new-balance");

  let selectedDollars: number | null = null;

  function updateSubmitState() {
    if (submitButton) {
      submitButton.disabled = !(selectedDollars !== null && selectedDollars > 0);
    }
  }

  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      chips.forEach((c) => c.setAttribute("aria-pressed", "false"));
      chip.setAttribute("aria-pressed", "true");
      selectedDollars = Number(chip.dataset.amount);
      if (customInput) customInput.value = "";
      updateSubmitState();
    });
  });

  customInput?.addEventListener("input", () => {
    chips.forEach((c) => c.setAttribute("aria-pressed", "false"));
    const value = Number(customInput.value);
    selectedDollars = Number.isFinite(value) && value > 0 ? value : null;
    updateSubmitState();
  });

  submitButton?.addEventListener("click", () => {
    if (selectedDollars === null) return;
    formView?.setAttribute("hidden", "");
    processingView?.removeAttribute("hidden");

    setTimeout(() => {
      const newBalanceCents = demoState.addBalanceCents(
        Math.round(selectedDollars! * 100),
      );
      if (newBalanceEl) newBalanceEl.textContent = formatCents(newBalanceCents);
      processingView?.setAttribute("hidden", "");
      successView?.removeAttribute("hidden");
    }, 1000);
  });
</script>

<style>
  .top-up-card-lede {
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .amount-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .top-up-status {
    text-align: center;
  }

  .top-up-status .btn {
    margin-top: var(--space-4);
  }

  .fare-facts {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .fare-facts__label {
    font-weight: 600;
    margin: 0 0 var(--space-1);
  }

  .fare-facts__detail {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin: 0;
  }
</style>
