---
import BaseLayout from "../layouts/BaseLayout.astro";
import { FARE_TABLE } from "../lib/fixtures";
---

<BaseLayout title="Home" depth={0}>
  <section class="hero">
    <p class="eyebrow">Transport Canberra</p>
    <h1>Your MyWay+ account, sorted.</h1>
    <p class="lede">
      Check your balance, top up, and manage your concession — all in one
      place, built around Transport Canberra's goal of transport that's
      accessible, flexible, reliable and sustainable enough to get more
      people onto buses and light rail.
    </p>
    <a class="cta" href="./dashboard/">Open your account →</a>
  </section>

  <section class="fares">
    <h2>Simple, real fares</h2>
    <p>
      Adult fares run from ${FARE_TABLE.adult.offPeak.toFixed(2)} off-peak to
      ${FARE_TABLE.adult.peak.toFixed(2)} at peak, with concession fares from
      ${FARE_TABLE.concession.offPeak.toFixed(2)} to{" "}
      ${FARE_TABLE.concession.peak.toFixed(2)}. Current as of{" "}
      {FARE_TABLE.effectiveFrom}.
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-7) var(--space-6);
    max-width: 38rem;
  }

  .eyebrow {
    color: var(--color-brand);
    font-weight: 600;
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 var(--space-3);
  }

  h1 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-4);
  }

  .lede {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .cta {
    display: inline-block;
    background: var(--color-brand-strong);
    color: var(--color-brand-contrast);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .cta:hover {
    background: var(--color-brand-stronger);
    color: var(--color-brand-contrast);
  }

  .fares {
    padding-block: var(--space-6);
    border-top: var(--border-width) solid var(--color-border);
    max-width: 38rem;
  }

  .fares h2 {
    font-size: var(--text-xl);
    margin-bottom: var(--space-3);
  }

  .fares p {
    color: var(--color-text-muted);
  }
</style>
