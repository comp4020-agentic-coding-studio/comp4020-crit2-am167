---
import RouteChip from "./RouteChip.astro";
import type { Departure } from "../lib/fixtures";

interface Props {
  departure: Departure;
}

const { departure } = Astro.props;
const routeLabel = departure.mode === "bus" ? departure.route : "Light rail";
const statusLabel =
  departure.status === "on-time"
    ? "On time"
    : `Delayed ${departure.delayMinutes} min`;
const etaLabel = departure.etaMinutes === 0 ? "Now" : `${departure.etaMinutes} min`;
---

<li class="list-row" data-mode={departure.mode}>
  <div class="list-row-main">
    <RouteChip mode={departure.mode} label={routeLabel} />
    <span class="list-row-title">{departure.headsign}</span>
  </div>
  <div class="list-row-meta">
    <span class="list-row-status" data-status={departure.status}>
      <span class="list-row-status-dot" aria-hidden="true"></span>
      {statusLabel}
    </span>
    <span class="list-row-eta tabular-nums">{etaLabel}</span>
  </div>
</li>
