---
import { DEFAULT_BALANCE_CENTS } from "../lib/demo-state";
import { formatCents } from "../lib/format";

const fallback = formatCents(DEFAULT_BALANCE_CENTS);
---

<div class="balance-card">
  <p class="balance-card__label">Balance</p>
  <p class="balance-card__amount tabular-nums" id="balance-amount">
    {fallback}
  </p>
  <p class="balance-card__delta">
    <span class="balance-card__delta-dot" aria-hidden="true"></span>
    +$20.00 top-up · 3 Aug
  </p>
  <a href="../top-up/" class="btn primary">Top up</a>
</div>

<script>
  import { demoState } from "../lib/demo-state";
  import { formatCents } from "../lib/format";

  const el = document.querySelector<HTMLElement>("#balance-amount");
  if (el) {
    el.textContent = formatCents(demoState.getBalanceCents());
  }
</script>

<style>
  .balance-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .balance-card__label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  .balance-card__amount {
    font-family: var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 700;
    margin: 0;
  }

  .balance-card__delta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: -0.5rem 0 0;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-status);
  }

  .balance-card__delta-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-status);
  }

  .balance-card .btn {
    align-self: flex-start;
  }
</style>
