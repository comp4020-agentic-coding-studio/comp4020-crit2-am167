---
interface Props {
  value: number;
}

const { value } = Astro.props;
---

<button
  type="button"
  class="amount-chip"
  data-amount={value}
  aria-pressed="false"
>
  ${value}
</button>

<style>
  .amount-chip {
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-pill);
    border: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 600;
    cursor: pointer;
  }

  .amount-chip:hover {
    border-color: var(--color-status);
  }

  /* Green, not the neutral action colour: picking an amount is the first half
     of the same money action the green "Top up" button completes, and the
     result shows up as a green balance delta. */
  .amount-chip[aria-pressed="true"] {
    background: var(--color-status);
    color: var(--color-action-contrast);
    border-color: var(--color-status);
  }
</style>
