---
import BentoTile from "./BentoTile.astro";
import BalanceCard from "./BalanceCard.astro";
import StatusCard from "./StatusCard.astro";
import DepartureListItem from "./DepartureListItem.astro";
import TripListItem from "./TripListItem.astro";
import LineDiagram from "./LineDiagram.astro";
import NextTrip from "./NextTrip.astro";
import {
  DEFAULT_AUTO_TOP_UP,
  DEFAULT_CONCESSION,
} from "../lib/demo-state";
import { CONCESSION_TYPES, DEPARTURES, SAMPLE_TRIPS } from "../lib/fixtures";
import { formatCents, formatDate } from "../lib/format";

interface Props {
  depth?: 0 | 1;
}

const { depth = 1 } = Astro.props;
const up = depth === 0 ? "./" : "../";
const recentTrips = SAMPLE_TRIPS.slice(0, 4);
const nextDeparture = DEPARTURES[0];

const concessionType = CONCESSION_TYPES.find(
  (type) => type.id === DEFAULT_CONCESSION.typeId,
);
const concessionDetail = concessionType
  ? `${concessionType.name} — active until ${formatDate(DEFAULT_CONCESSION.expiry)}`
  : "No concession on file";

const autoTopUpDetail = DEFAULT_AUTO_TOP_UP.enabled
  ? `On — tops up to ${formatCents(DEFAULT_AUTO_TOP_UP.targetCents)} below ${formatCents(DEFAULT_AUTO_TOP_UP.thresholdCents)}`
  : "Off — you'll need to top up manually";
---

<div class="dashboard">
  <header class="dashboard__intro">
    <div>
      <p class="dashboard__eyebrow">MyWay+ account</p>
      <h1>Your travel today</h1>
      <p class="dashboard__lede">
        Keep an eye on your next departure, balance, and recent journeys.
      </p>
    </div>
    <a class="btn secondary dashboard__map-link" href={`${up}live-map/`}>
      View live network
    </a>
  </header>

  <section class="dashboard__top-row">
    <BentoTile size="hero">
      <NextTrip departure={nextDeparture} up={up} />
    </BentoTile>
    <BentoTile>
      <BalanceCard up={up} />
    </BentoTile>
    <BentoTile>
      <LineDiagram />
    </BentoTile>
  </section>

  <section class="dashboard__status-row" aria-label="Account settings">
    <BentoTile>
      <StatusCard
        dataRole="auto-top-up-status"
        status={DEFAULT_AUTO_TOP_UP.enabled ? "active" : "off"}
        label="Auto top-up"
        detail={autoTopUpDetail}
        href={`${up}auto-top-up/`}
        linkText="Manage auto top-up"
      />
    </BentoTile>
    <BentoTile>
      <StatusCard
        dataRole="concession-status"
        status="active"
        label="Concession discount"
        detail={concessionDetail}
        href={`${up}concession/`}
        linkText="Manage concession"
      />
    </BentoTile>
  </section>

  <section class="dashboard__departures">
    <BentoTile>
      <div class="dashboard__section-head">
        <h2>Live departures</h2>
        <div class="dashboard__section-meta">
          <span class="dashboard__live-badge">
            <span class="dashboard__live-dot" aria-hidden="true"></span>
            Live
          </span>
          <span>Demo feed · updated just now</span>
        </div>
      </div>
      <ul class="departures-list">
        {
          DEPARTURES.map((departure) => (
            <DepartureListItem departure={departure} />
          ))
        }
      </ul>
    </BentoTile>
  </section>

  <section class="dashboard__history">
    <BentoTile>
      <div class="dashboard__section-head">
        <h2>Recent trips</h2>
        <a href={`${up}trips/`}>See all trip history →</a>
      </div>
      <ul class="trips-list">
        {recentTrips.map((trip) => <TripListItem trip={trip} />)}
      </ul>
    </BentoTile>
  </section>
</div>

<script>
  import { demoState } from "../lib/demo-state";
  import { CONCESSION_TYPES } from "../lib/fixtures";
  import { formatCents, formatDate } from "../lib/format";

  const autoTopUp = demoState.getAutoTopUp();
  const autoTopUpCard = document.querySelector<HTMLElement>(
    '[data-role="auto-top-up-status"]',
  );
  const autoTopUpDetailEl = document.querySelector<HTMLElement>(
    '[data-role="auto-top-up-status-detail"]',
  );
  if (autoTopUpCard && autoTopUpDetailEl) {
    autoTopUpCard.dataset.status = autoTopUp.enabled ? "active" : "off";
    autoTopUpDetailEl.textContent = autoTopUp.enabled
      ? `On — tops up to ${formatCents(autoTopUp.targetCents)} below ${formatCents(autoTopUp.thresholdCents)}`
      : "Off — you'll need to top up manually";
  }

  const concession = demoState.getConcession();
  const concessionType = CONCESSION_TYPES.find(
    (type) => type.id === concession.typeId,
  );
  const concessionDetailEl = document.querySelector<HTMLElement>(
    '[data-role="concession-status-detail"]',
  );
  if (concessionDetailEl) {
    concessionDetailEl.textContent = concessionType
      ? `${concessionType.name} — active until ${formatDate(concession.expiry)}`
      : "No concession on file";
  }
</script>

<style>
  .dashboard {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .dashboard__intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .dashboard__eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--color-status);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .dashboard__intro h1 {
    margin: 0;
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
  }

  .dashboard__lede {
    max-width: 38rem;
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
  }

  .dashboard__map-link {
    flex-shrink: 0;
  }

  .dashboard__top-row {
    display: grid;
    grid-template-columns: minmax(0, 1.8fr) minmax(15rem, 0.9fr) minmax(17rem, 1fr);
    gap: var(--space-5);
    align-items: stretch;
  }

  .dashboard__top-row > *,
  .dashboard__status-row > * {
    min-width: 0;
  }

  .dashboard__status-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .dashboard__section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .dashboard__section-head h2 {
    margin: 0;
    font-size: var(--text-lg);
  }

  .dashboard__section-meta {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-3);
    color: var(--color-text-dim);
    font-size: var(--text-xs);
  }

  .dashboard__section-head a {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .dashboard__section-head a:hover {
    color: var(--color-action-hover);
  }

  .dashboard__live-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-status);
  }

  .dashboard__live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-status);
    animation: dashboard-live-pulse 2s ease-in-out infinite;
  }

  @keyframes dashboard-live-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dashboard__live-dot {
      animation: none;
    }
  }

  .departures-list,
  .trips-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  @media (max-width: 1023px) {
    .dashboard__top-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dashboard__top-row > :first-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .dashboard {
      gap: var(--space-6);
    }

    .dashboard__intro {
      align-items: stretch;
      flex-direction: column;
    }

    .dashboard__map-link {
      width: 100%;
    }

    .dashboard__top-row {
      grid-template-columns: 1fr;
    }

    .dashboard__top-row > :first-child {
      grid-column: auto;
    }

    .dashboard__status-row {
      grid-template-columns: 1fr;
    }

    .dashboard__section-head {
      align-items: flex-start;
      flex-direction: column;
    }

    .dashboard__section-meta {
      justify-content: flex-start;
    }
  }
</style>
