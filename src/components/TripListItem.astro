---
import { formatCents } from "../lib/format";
import type { Trip } from "../lib/fixtures";

interface Props {
  trip: Trip;
}

const { trip } = Astro.props;

const modeLabel = trip.mode === "bus" ? "Bus" : "Light rail";
const fareTypeLabel: Record<Trip["fareType"], string> = {
  peak: "Peak",
  "off-peak": "Off-peak",
  transfer: "Free transfer",
  capped: "Capped",
};
---

<li class="trip-item" data-mode={trip.mode}>
  <div class="trip-item__main">
    <span class="trip-item__mode">{modeLabel}</span>
    <span class="trip-item__route">{trip.route}</span>
    <span class="trip-item__stops">{trip.from} → {trip.to}</span>
  </div>
  <div class="trip-item__meta">
    <span class="trip-item__badge">{fareTypeLabel[trip.fareType]}</span>
    <span class="trip-item__fare tabular-nums">
      {formatCents(Math.round(trip.fare * 100))}
    </span>
  </div>
</li>

<style>
  .trip-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding: var(--space-3);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-left: 3px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .trip-item[data-mode="bus"] {
    border-left-color: var(--color-mode-bus);
  }

  .trip-item[data-mode="light-rail"] {
    border-left-color: var(--color-mode-tram);
  }

  .trip-item__main {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .trip-item__mode {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .trip-item[data-mode="bus"] .trip-item__mode {
    color: var(--color-mode-bus);
  }

  .trip-item[data-mode="light-rail"] .trip-item__mode {
    color: var(--color-mode-tram);
  }

  .trip-item__route {
    font-weight: 600;
  }

  .trip-item__stops {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .trip-item__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .trip-item__badge {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    background: var(--color-surface-raised);
    border: var(--border-width) solid var(--color-border);
    padding: 0.1rem var(--space-2);
    border-radius: var(--radius-pill);
  }

  .trip-item__fare {
    font-weight: 600;
  }
</style>
