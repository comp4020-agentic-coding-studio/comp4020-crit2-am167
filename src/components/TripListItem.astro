---
import RouteChip from "./RouteChip.astro";
import { formatCents } from "../lib/format";
import type { Trip } from "../lib/fixtures";

interface Props {
  trip: Trip;
}

const { trip } = Astro.props;

const routeLabel = trip.mode === "bus" ? trip.route : "Light rail";
const fareTypeLabel: Record<Trip["fareType"], string> = {
  peak: "Peak",
  "off-peak": "Off-peak",
  transfer: "Free transfer",
  capped: "Capped",
};
---

<li class="list-row" data-mode={trip.mode}>
  <div class="list-row-main">
    <RouteChip mode={trip.mode} label={routeLabel} />
    <span class="trip-item__stops">{trip.from} → {trip.to}</span>
  </div>
  <div class="list-row-meta">
    <span class="trip-item__badge">{fareTypeLabel[trip.fareType]}</span>
    <span class="trip-item__fare tabular-nums">
      {formatCents(Math.round(trip.fare * 100))}
    </span>
  </div>
</li>

<style>
  .trip-item__stops {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  /* White, not --color-surface-raised: the row behind it is already raised, so
     a raised badge on a raised row had almost no edge to read. */
  .trip-item__badge {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    padding: 0.1rem var(--space-2);
    border-radius: var(--radius-pill);
  }

  .trip-item__fare {
    font-weight: 600;
    font-family: var(--font-display);
  }
</style>
