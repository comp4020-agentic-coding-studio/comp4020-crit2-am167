---
interface Props {
  size?: "hero" | "medium" | "small";
}

const { size = "medium" } = Astro.props;
---

<div class:list={["bento-tile", `bento-tile--${size}`]}>
  <slot />
</div>

<style>
  .bento-tile {
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: none;
    padding: var(--space-5);
  }

  .bento-tile--hero {
    border-color: var(--color-border-hero);
    background: linear-gradient(
      135deg,
      var(--color-surface),
      var(--color-surface-hero)
    );
    box-shadow: var(--shadow-card);
  }
</style>
