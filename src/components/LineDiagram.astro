---
import { LIGHT_RAIL_LINE } from "../lib/fixtures";

const { stops, nextStopIndex, name } = LIGHT_RAIL_LINE;

// Only the stops immediately around "you are here" — this panel's job is
// position-in-journey, not a full timetable (that's what Live departures is
// for, one card over).
const STOPS_BEFORE = 2;
const STOPS_AFTER = 2;
const windowStart = Math.max(0, nextStopIndex - STOPS_BEFORE);
const windowEnd = Math.min(stops.length - 1, nextStopIndex + STOPS_AFTER);
const windowStops = stops.slice(windowStart, windowEnd + 1);
const hiddenBefore = windowStart;
const hiddenAfter = stops.length - 1 - windowEnd;
---

<div class="line-diagram">
  <p class="line-diagram__eyebrow">{name}</p>
  {
    hiddenBefore > 0 && (
      <p class="line-diagram__more">
        ⋯ {hiddenBefore} earlier stop{hiddenBefore === 1 ? "" : "s"}
      </p>
    )
  }
  <ol class="line-diagram__stops">
    {
      windowStops.map((stop, i) => {
        const stopIndex = windowStart + i;
        return (
          <li
            class:list={[
              "line-diagram__stop",
              stopIndex < nextStopIndex && "is-passed",
              stopIndex === nextStopIndex && "is-next",
            ]}
          >
            <span class="line-diagram__dot" aria-hidden="true" />
            <span class="line-diagram__name">{stop}</span>
            {stopIndex === nextStopIndex && (
              <span class="line-diagram__here">You are here</span>
            )}
          </li>
        );
      })
    }
  </ol>
  {
    hiddenAfter > 0 && (
      <p class="line-diagram__more">
        ⋯ {hiddenAfter} more stop{hiddenAfter === 1 ? "" : "s"}
      </p>
    )
  }
</div>

<style>
  .line-diagram {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
  }

  .line-diagram__eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: 0.01em;
    color: var(--color-text);
  }

  .line-diagram__more {
    margin: 0;
    padding-left: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-text-dim);
  }

  .line-diagram__stops {
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--space-2);
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .line-diagram__stops::before {
    content: "";
    position: absolute;
    left: calc(var(--space-2) + 3px);
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--color-rail);
    opacity: 0.35;
  }

  .line-diagram__stop {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: 0.4rem 0 0.4rem var(--space-4);
  }

  .line-diagram__dot {
    position: absolute;
    left: -1px;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--color-rail);
  }

  .line-diagram__stop.is-passed .line-diagram__dot {
    background: var(--color-rail);
  }

  .line-diagram__stop.is-passed .line-diagram__name {
    color: var(--color-text-muted);
  }

  .line-diagram__name {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .line-diagram__stop.is-next .line-diagram__name {
    color: var(--color-text);
    font-weight: 700;
  }

  .line-diagram__stop.is-next .line-diagram__dot {
    background: var(--color-status);
    border-color: var(--color-status);
    opacity: 1;
    box-shadow: 0 0 0 4px var(--color-status-bg);
    animation: line-diagram-pulse 2s ease-in-out infinite;
  }

  .line-diagram__here {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-status);
  }

  @keyframes line-diagram-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 4px var(--color-status-bg);
    }
    50% {
      box-shadow: 0 0 0 7px var(--color-status-bg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .line-diagram__stop.is-next .line-diagram__dot {
      animation: none;
    }
  }
</style>
