---
import { LIGHT_RAIL_LINE } from "../lib/fixtures";

const { stops, nextStopIndex, name } = LIGHT_RAIL_LINE;
---

<div class="line-diagram">
  <p class="line-diagram__eyebrow">{name}</p>
  <ol class="line-diagram__stops">
    {
      stops.map((stop, i) => (
        <li
          class:list={[
            "line-diagram__stop",
            i < nextStopIndex && "is-passed",
            i === nextStopIndex && "is-next",
          ]}
        >
          <span class="line-diagram__dot" aria-hidden="true" />
          <span class="line-diagram__name">{stop}</span>
          {i === nextStopIndex && (
            <span class="line-diagram__live">
              <span class="line-diagram__live-dot" aria-hidden="true" />
              Live · next stop
            </span>
          )}
        </li>
      ))
    }
  </ol>
</div>

<style>
  .line-diagram {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-card);
    padding: var(--space-5) var(--space-5) var(--space-6);
  }

  .line-diagram__eyebrow {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: 0.01em;
    color: var(--color-text);
  }

  .line-diagram__stops {
    list-style: none;
    margin: 0;
    padding: 0 0 0 var(--space-2);
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .line-diagram__stops::before {
    content: "";
    position: absolute;
    left: calc(var(--space-2) + 3px);
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--color-rail);
    opacity: 0.35;
  }

  .line-diagram__stop {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: 0.4rem 0 0.4rem var(--space-4);
  }

  .line-diagram__dot {
    position: absolute;
    left: -1px;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--color-rail);
  }

  .line-diagram__stop.is-passed .line-diagram__dot {
    background: var(--color-rail);
  }

  .line-diagram__stop.is-passed .line-diagram__name {
    color: var(--color-text-muted);
  }

  .line-diagram__name {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .line-diagram__stop.is-next .line-diagram__name {
    color: var(--color-text);
    font-weight: 700;
  }

  .line-diagram__stop.is-next .line-diagram__dot {
    background: var(--color-status);
    border-color: var(--color-status);
    opacity: 1;
    box-shadow: 0 0 0 4px var(--color-status-bg);
    animation: line-diagram-pulse 2s ease-in-out infinite;
  }

  .line-diagram__live {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-status);
  }

  .line-diagram__live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-status);
  }

  @keyframes line-diagram-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 4px var(--color-status-bg);
    }
    50% {
      box-shadow: 0 0 0 7px var(--color-status-bg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .line-diagram__stop.is-next .line-diagram__dot {
      animation: none;
    }
  }

  /* Below the desktop two-column dashboard grid, the spine runs sideways
     as a scrollable strip instead of a full-height sidebar. */
  @media (max-width: 1023px) {
    .line-diagram {
      height: auto;
    }

    .line-diagram__stops {
      flex-direction: row;
      align-items: flex-start;
      overflow-x: auto;
      min-width: 0;
      padding: var(--space-2) var(--space-1) var(--space-3);
      gap: var(--space-1);
      scroll-snap-type: x proximity;
    }

    .line-diagram__stops::before {
      left: 0.5rem;
      right: 0.5rem;
      top: 3px;
      bottom: auto;
      height: 2px;
      width: auto;
    }

    .line-diagram__stop {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
      padding: var(--space-3) var(--space-4) 0 var(--space-3);
      min-width: 6.5rem;
      scroll-snap-align: start;
    }

    .line-diagram__dot {
      left: 0;
      top: -1px;
      transform: translate(-50%, -50%);
    }

    .line-diagram__name {
      white-space: normal;
    }
  }
</style>
