---
interface Props {
  mode: "bus" | "light-rail";
  label: string;
}

const { mode, label } = Astro.props;
---

<span class="route-chip" data-mode={mode}>{label}</span>

<style>
  .route-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem var(--space-3);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .route-chip[data-mode="bus"] {
    background: var(--color-bus);
    color: var(--color-action-contrast);
  }

  .route-chip[data-mode="light-rail"] {
    background: var(--color-rail);
    color: var(--color-action-contrast);
  }
</style>
