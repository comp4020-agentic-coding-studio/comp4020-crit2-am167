---
import "../styles/global.css";

import { ACCOUNT_NAME } from "../lib/fixtures";

interface Props {
  title: string;
  /**
   * How many directory levels below the site root this page's *output
   * file* sits — not its URL. Every page except index.astro and
   * 404.astro (both of which Astro emits at the root, alongside each
   * other) builds to `pagename/index.html`, one level deeper. Nav links
   * need "../" from those, "./" from the two root-level pages.
   */
  depth?: 0 | 1;
  /** Lets the dashboard fill wide viewports instead of sitting inside the
   * narrower reading-width column the form/settings pages use. */
  wide?: boolean;
  /** False only on the login/signup pages themselves — everywhere else the
   * app is already showing a signed-in user's balance and trips, so the nav
   * shows the account chip instead of "Log in" / "Sign up". */
  loggedIn?: boolean;
}

const { title, depth = 1, wide = false, loggedIn = true } = Astro.props;
const up = depth === 0 ? "./" : "../";

const navLinks = [
  { href: `${up}dashboard/`, label: "Dashboard" },
  { href: `${up}trips/`, label: "Trip history" },
  { href: `${up}top-up/`, label: "Top up" },
  { href: `${up}auto-top-up/`, label: "Auto top-up" },
  { href: `${up}concession/`, label: "Concession" },
  { href: `${up}live-map/`, label: "Live map" },
];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — MyWay+</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__bar">
        <a class="wordmark" href={up} aria-label="MyWay+ home">
          <img
            class="wordmark__logo"
            src={`${up}assets/myway-plus-app-icon.webp`}
            alt="MyWay+"
            width="112"
            height="36"
          />
        </a>
        <nav aria-label="Primary" class="primary-nav">
          <div id="primary-nav-panel" class="primary-nav__panel">
            <ul class="primary-nav__links">
              {
                navLinks.map((link) => (
                  <li>
                    <a
                      class:list={[link.label === title && "is-current"]}
                      href={link.href}
                      aria-current={link.label === title ? "page" : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
            <ul class="primary-nav__auth">
              {
                loggedIn ? (
                  <li class="account-chip">
                    <span class="account-chip__avatar" aria-hidden="true">
                      {ACCOUNT_NAME.charAt(0)}
                    </span>
                    <span class="account-chip__name">{ACCOUNT_NAME}</span>
                  </li>
                ) : (
                  <>
                    <li><a href={`${up}login/`}>Log in</a></li>
                    <li><a class="is-primary" href={`${up}signup/`}>Sign up</a></li>
                  </>
                )
              }
            </ul>
          </div>
        </nav>
        <div class="site-header__actions">
          <button
            type="button"
            id="nav-toggle"
            class="nav-toggle"
            aria-expanded="false"
            aria-controls="primary-nav-panel"
          >
            Menu
          </button>
        </div>
      </div>
    </header>
    <main class:list={[wide && "main-wide"]}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>
          A student prototype, not an official Transport Canberra service.
          For the real thing, call <strong>13&nbsp;17&nbsp;10</strong> or
          contact Access Canberra.
        </p>
        <a
          class="site-footer__official-link"
          href="https://www.mywayplus.transport.act.gov.au/login"
          target="_blank"
          rel="noopener noreferrer"
        >
          Visit the official MyWay+ website ↗
        </a>
      </div>
    </footer>
    <script>
      const navToggle = document.querySelector<HTMLButtonElement>("#nav-toggle");
      const navPanel = document.querySelector<HTMLElement>("#primary-nav-panel");
      navToggle?.addEventListener("click", () => {
        const isOpen = navPanel?.classList.toggle("is-open") ?? false;
        navToggle.setAttribute("aria-expanded", String(isOpen));
        navToggle.textContent = isOpen ? "Close" : "Menu";
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: var(--border-width) solid var(--color-border);
    background: rgb(255 255 255 / 92%);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .site-header__bar {
    max-width: 96rem;
    margin: 0 auto;
    padding: var(--space-4) var(--space-5);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
  }

  .wordmark {
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--color-text);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .wordmark__logo {
    display: block;
    width: 7rem;
    height: 2.25rem;
    object-fit: cover;
    object-position: center;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .nav-toggle {
    border: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
  }

  .primary-nav {
    min-width: 0;
  }

  .primary-nav__panel {
    display: none;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .primary-nav__panel.is-open {
    display: flex;
  }

  .primary-nav__links,
  .primary-nav__auth {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .primary-nav__links a,
  .primary-nav__auth a {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .primary-nav__links a:hover,
  .primary-nav__auth a:hover {
    background: var(--color-surface-raised);
    color: var(--color-action-hover);
  }

  .primary-nav__links a.is-current {
    background: var(--color-surface-raised);
    color: var(--color-action-hover);
    font-weight: 700;
  }

  .primary-nav__auth a.is-primary {
    background: var(--color-action);
    color: var(--color-action-contrast);
  }

  .primary-nav__auth a.is-primary:hover {
    background: var(--color-action-hover);
    color: var(--color-action-contrast);
  }

  .account-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .account-chip__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--color-surface-raised);
    border: var(--border-width) solid var(--color-border);
    font-family: var(--font-display);
    font-size: var(--text-xs);
  }

  @media (min-width: 720px) {
    .nav-toggle {
      display: none;
    }

    .primary-nav__panel {
      display: flex !important;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3);
    }

    .primary-nav__links {
      justify-content: center;
    }

    .primary-nav__auth {
      justify-content: flex-end;
    }
  }

  @media (max-width: 719px) {
    .primary-nav {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .primary-nav__panel {
      padding-top: var(--space-2);
    }

    .primary-nav__links a,
    .primary-nav__auth a {
      width: 100%;
    }

    .primary-nav__links li,
    .primary-nav__auth li {
      flex: 1 1 9rem;
    }

    .account-chip {
      padding-left: var(--space-3);
    }
  }

  .site-footer {
    border-top: var(--border-width) solid var(--color-border);
    margin-top: var(--space-8);
  }

  .site-footer__inner {
    max-width: 96rem;
    margin: 0 auto;
    padding: var(--space-5);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .site-footer__official-link {
    display: inline-block;
    margin-top: var(--space-2);
    color: var(--color-text);
    font-weight: 700;
  }
</style>
